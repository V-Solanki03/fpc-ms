# ---- Database (required on Vercel). Locally, leave empty to use an embedded database in .data/ ----
DATABASE_URL=

# ---- Access (required in production: the app refuses to open without it) ----
APP_PASSWORD=
SESSION_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-too

# ---- Zoho CRM (India data centre). Create a Self Client at api-console.zoho.in ----
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in
ZOHO_ORG_ID=1363009000000020813
# Writes to Zoho (only through approved hygiene fixes). Leave false until you trust it.
ZOHO_WRITE_ENABLED=false

# ---- Email. Reports are saved as previews until EMAIL_LIVE=true ----
EMAIL_LIVE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FPC-MS <you@faceprep.in>"
ADMIN_EMAIL=varun.solanki@faceprep.in

# ---- Optional AI (Gemini) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MONTHLY_CALL_CAP=300
